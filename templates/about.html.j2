<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ person.name }} &mdash; About</title>
  <style>
    /* ══════════════════════════════════════════════════════════════════
       THE MONOSPACE WEB — brutalist design system + console palette
       Adapted from Oskar Wickström's "The Monospace Web" (MIT).
       Everything snaps to a character grid: 1ch wide x --line-height tall.

       Colour roles read like a terminal session:
         green    section headings, prompts, bullets, nav brackets
         blue     links + the first row (header) of every table
         cyan     row labels / key columns, sub-headings
         amber    dates and inline code
         magenta  tags / chips
       Light mode uses darkened variants (>=4.5:1 on white); dark mode
       switches to the bright ANSI-ish variants.
       ══════════════════════════════════════════════════════════════════ */
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap');

    :root {
      --font-family: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
      --line-height: 1.20rem;
      --border-thickness: 2px;

      --text-color:           #000;
      --text-color-alt:       #666;
      --background-color:      #fff;
      --background-color-alt:  #eee;

      /* ── Console palette — light mode (darkened for white background) ─ */
      --c-green:      #1a7f37;
      --c-green-dim:  #3d9e5b;
      --c-blue:       #0969da;
      --c-blue-fg:    #0550ae;
      --c-blue-bg:    #ddf4ff;
      --c-cyan:       #0e7490;
      --c-amber:      #9a6700;
      --c-amber-bg:   #fff8c5;
      --c-magenta:    #8250df;

      --font-weight-normal: 500;
      --font-weight-medium: 600;
      --font-weight-bold:   800;

      font-family: var(--font-family);
      font-optical-sizing: auto;
      font-weight: var(--font-weight-normal);
      font-style: normal;
      font-variant-numeric: tabular-nums lining-nums;
      font-size: 16px;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --text-color:          #fff;
        --text-color-alt:      #aaa;
        --background-color:     #000;
        --background-color-alt: #111;

        /* ── Console palette — dark mode (bright terminal variants) ──── */
        --c-green:      #3fb950;
        --c-green-dim:  #2ea043;
        --c-blue:       #58a6ff;
        --c-blue-fg:    #a5d6ff;
        --c-blue-bg:    #0c2d4e;
        --c-cyan:       #39c5cf;
        --c-amber:      #d29922;
        --c-amber-bg:   #2b2106;
        --c-magenta:    #d2a8ff;
      }
    }

    /* ── Reset + the "owl" vertical rhythm ──────────────────────────── */
    *          { box-sizing: border-box; }
    * + *      { margin-top: var(--line-height); }   /* one line of rhythm between siblings */

    html {
      background: var(--background-color);
      color: var(--text-color);
      -webkit-text-size-adjust: 100%;
    }

    body {
      position: relative;
      width: 100%;
      margin: 0 auto;
      padding: var(--line-height) 2ch;
      max-width: 80ch;                                   /* fallback for no round() */
      max-width: calc(min(80ch, round(down, 100%, 1ch)));
      line-height: var(--line-height);
      overflow-x: hidden;
    }

    @media screen and (max-width: 480px) {
      :root { font-size: 14px; }
      body  { padding: var(--line-height) 1ch; }
    }

    /* ── Headings ───────────────────────────────────────────────────── */
    h1, h2, h3, h4, h5, h6 {
      font-weight: var(--font-weight-bold);
      line-height: var(--line-height);
      margin: calc(var(--line-height) * 2) 0 var(--line-height);
    }
    h1 {
      font-size: 2rem;
      line-height: calc(2 * var(--line-height));
      text-transform: uppercase;
      letter-spacing: -0.03em;
    }
    h2 { font-size: 1rem; text-transform: uppercase; }
    h3 { font-size: 1rem; text-transform: uppercase; color: var(--c-cyan); }

    /* Section headers rendered like a markdown/shell "## TITLE" */
    .section       { margin-top: calc(var(--line-height) * 2); }
    .section-title {
      font-size: 1rem;
      text-transform: uppercase;
      font-weight: var(--font-weight-bold);
      margin: 0 0 var(--line-height);
      color: var(--c-green);
      border-bottom: var(--border-thickness) solid var(--c-green);
      padding-bottom: calc(var(--line-height) / 2 - var(--border-thickness));
    }
    .section-title::before {
      content: "## ";
      color: var(--c-green-dim);
      font-weight: var(--font-weight-medium);
    }

    /* ── Links ──────────────────────────────────────────────────────── */
    a {
      color: var(--c-blue);
      text-decoration: underline;
      text-decoration-thickness: var(--border-thickness);
      text-underline-offset: 2px;
    }
    a:hover { background: var(--c-blue); color: var(--background-color); text-decoration: none; }

    strong { font-weight: var(--font-weight-bold); }
    em     { font-style: italic; }

    p { margin-bottom: var(--line-height); word-wrap: break-word; overflow-wrap: break-word; }

    code {
      font-family: var(--font-family);
      font-weight: var(--font-weight-medium);
      color: var(--c-amber);
      background: var(--c-amber-bg);
      padding: 0 0.4ch;
    }

    /* ── Horizontal rule (double bar) ───────────────────────────────── */
    hr {
      position: relative; display: block;
      height: var(--line-height);
      margin: calc(var(--line-height) * 1.5) 0;
      border: none; color: var(--c-green);
    }
    hr:after {
      content: ""; display: block; position: absolute;
      top: calc(var(--line-height) / 2 - var(--border-thickness));
      left: 0; width: 100%; height: 0;
      border-top: calc(var(--border-thickness) * 3) double var(--c-green);
    }

    /* ── Tables (the signature look) ────────────────────────────────── */
    table {
      position: relative;
      width: 100%;
      width: calc(round(down, 100%, 1ch));
      border-collapse: collapse;
      margin: 0 0 var(--line-height);
    }
    th, td {
      border: var(--border-thickness) solid var(--text-color);
      padding: calc(var(--line-height) / 2) 1ch;
      line-height: var(--line-height);
      vertical-align: top;
      text-align: left;
    }
    th { font-weight: var(--font-weight-bold); text-transform: uppercase; }
    /* first row of a table = the "column header" line of console output */
    thead th {
      color: var(--c-blue-fg);
      background: var(--c-blue-bg);
    }
    /* row labels (key column) in key/value tables */
    tbody th { color: var(--c-cyan); }
    .width-min  { width: 0%; white-space: nowrap; }
    .width-auto { width: 100%; }
    td a, th a { text-decoration-thickness: var(--border-thickness); }
    /* date / year columns */
    .date-cell { color: var(--c-amber); }

    /* ── Lists ──────────────────────────────────────────────────────── */
    ul, ol { padding: 0; margin: 0 0 var(--line-height); }
    ul { list-style-type: square; padding-left: 2ch; }
    ol { list-style-type: decimal; padding-left: 3ch; }
    li { margin: 0; }               /* kills the owl margin so bullets pack tight */
    li::marker { line-height: 0; color: var(--c-green); }
    ul ul, ul ol, ol ul, ol ol { margin: 0; padding-left: 3ch; }

    /* ── Header / masthead ──────────────────────────────────────────── */
    .header      { margin-bottom: calc(var(--line-height) * 2); }
    .header h1   { margin: 0; }
    .subtitle    { color: var(--c-cyan); font-weight: var(--font-weight-medium); margin: calc(var(--line-height) / 2) 0 0; }
    .header table, .header .subtitle { margin-bottom: 0; }
    .header .contacts { margin-top: var(--line-height); }
    .header .contacts th { width: 0%; white-space: nowrap; }

    /* ── Nav (bracketed like a shell prompt, inverts when active) ───── */
    .nav {
      display: flex; flex-wrap: wrap; gap: 0 3ch;
      justify-content: space-between;
      margin: 0 0 var(--line-height);
    }
    .nav .group { display: flex; gap: 1ch; margin: 0; }
    .nav a { margin: 0; text-decoration: none; }
    .nav a::before { content: "["; color: var(--c-green-dim); }
    .nav a::after  { content: "]"; color: var(--c-green-dim); }
    .nav a:hover              { background: var(--c-green); color: var(--background-color); }
    .nav a:hover::before,
    .nav a:hover::after       { color: var(--background-color); }
    .nav a.active             { background: var(--c-green); color: var(--background-color); text-decoration: none; }
    .nav a.active::before,
    .nav a.active::after      { color: var(--background-color); }

    /* ── Tags / chips (bordered, square, brutalist) ─────────────────── */
    .tags { display: flex; flex-wrap: wrap; gap: 0.5ch; margin: 0; }
    .tag {
      display: inline-block; margin: 0;
      color: var(--c-magenta);
      border: var(--border-thickness) solid var(--c-magenta);
      padding: 0 0.5ch;
      font-size: 0.8rem;
      font-weight: var(--font-weight-medium);
      line-height: calc(var(--line-height) - var(--border-thickness));
      white-space: nowrap;
    }

    /* ── CV entries (experience / projects) ─────────────────────────── */
    .entry      { margin-top: calc(var(--line-height) * 1.5); }
    .entry-head {
      display: flex; justify-content: space-between; align-items: baseline;
      flex-wrap: wrap; gap: 0 1ch; margin: 0;
      border-bottom: var(--border-thickness) solid var(--text-color);
      padding-bottom: calc(var(--line-height) / 2 - var(--border-thickness));
    }
    .entry-title { font-weight: var(--font-weight-bold); margin: 0; }
    .entry-title::before {                 /* prompt sigil, like a run command */
      content: "$ ";
      color: var(--c-green);
      font-weight: var(--font-weight-medium);
    }
    .entry-date  { color: var(--c-amber); white-space: nowrap; margin: 0; }
    .entry-sub   { color: var(--c-cyan); font-weight: var(--font-weight-medium); margin: calc(var(--line-height) / 2) 0 0; }
    .entry ul    { margin-top: calc(var(--line-height) / 2); }

    .muted { color: var(--text-color-alt); }

    /* ── Posts grid (bordered cards, no radius, no shadow) ──────────── */
    .posts {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--line-height) 2ch;
      margin: 0;
    }
    @media (max-width: 640px) { .posts { grid-template-columns: 1fr; } }

    .post {
      display: flex; flex-direction: column;
      border: var(--border-thickness) solid var(--text-color);
      margin: 0;
      color: var(--text-color);
      text-decoration: none;
    }
    .post:hover { background: var(--background-color-alt); color: var(--text-color); border-color: var(--c-green); }
    .post:hover .post-title { text-decoration: underline; text-decoration-thickness: var(--border-thickness); }

    .post-img {
      margin: 0; aspect-ratio: 16 / 9; overflow: hidden;
      border-bottom: var(--border-thickness) solid var(--text-color);
      background: var(--background-color-alt);
    }
    .post-img img { display: block; width: 100%; height: 100%; object-fit: cover; margin: 0; }
    .post-noimg {
      margin: 0; aspect-ratio: 16 / 9;
      display: flex; align-items: center; justify-content: center;
      color: var(--text-color-alt); font-size: 0.8rem; letter-spacing: 0.1em;
      border-bottom: var(--border-thickness) solid var(--text-color);
      background: var(--background-color-alt);
    }
    .post-body {
      flex: 1; margin: 0;
      padding: calc(var(--line-height) / 2) 1ch var(--line-height);
      display: flex; flex-direction: column; gap: calc(var(--line-height) / 2);
    }
    .post-date  { color: var(--c-amber); font-size: 0.8rem; margin: 0; }
    .post-title { font-weight: var(--font-weight-bold); margin: 0; }
    a.post .post-title { color: var(--c-blue); }   /* the whole card is a link */
    .post-desc  { margin: 0; flex: 1; font-size: 0.9rem; }
    .post-body .tags { margin: 0; }

    /* ── Footer (rendered like a shell comment) ─────────────────────── */
    .footer {
      margin-top: calc(var(--line-height) * 2);
      padding-top: var(--line-height);
      border-top: var(--border-thickness) solid var(--c-green-dim);
      color: var(--text-color-alt);
      font-size: 0.85rem;
    }
    .footer::before { content: "# "; color: var(--c-green-dim); }
    .footer a { color: var(--text-color-alt); }

    /* ── About: 16:9 image shuffler (constant speed, stops at 5s) ───── */
    /* 16:9 on purpose: the video plays in this very box, so clicking play
       swaps the content without moving a single pixel of the layout. */
    .shuffle {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      margin: 0 auto;
      overflow: hidden;
      border: var(--border-thickness) solid var(--text-color);
      background: var(--background-color-alt);
    }
    /* .frame = one rotating photo. The play button is deliberately NOT one. */
    .shuffle .frame {
      position: absolute; inset: 0; margin: 0;
      display: none;
      width: 100%; height: 100%;
      object-fit: cover;
    }
    .shuffle .frame.on { display: block; }
    .shuffle-empty {
      position: absolute; inset: 0; margin: 0;
      display: flex; align-items: center; justify-content: center;
      padding: 0 2ch; text-align: center;
      color: var(--text-color-alt); font-size: 0.8rem;
    }
    /* Only the <noscript> video links use this now — rendered like a running
       command. The live status line under the square was removed. */
    .shuffle-caption {
      display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 1ch;
      margin: calc(var(--line-height) / 2) auto 0;
      font-size: 0.8rem;
    }
    .shuffle-caption > * { margin: 0; }
    .shuffle-cmd { color: var(--c-cyan); }
    .shuffle-cmd::before { content: "$ "; color: var(--c-green); }

    /* ── Play button — revealed only once the shuffle has stopped ────── */
    .shuffle-play {
      position: absolute; inset: 0; margin: 0;
      display: none;
      align-items: center; justify-content: center;
      padding: 0; border: 0;
      background: transparent;
      font: inherit; color: inherit;
      -webkit-appearance: none; appearance: none;
      cursor: pointer;
    }
    .shuffle-play.on { display: flex; }
    .shuffle-play .cap {
      margin: 0;
      width: 34%; max-width: 140px; height: auto;
      border: var(--border-thickness) solid #fff;
      background: #000; color: #fff;
      transition: transform 100ms linear, border-color 100ms linear;
    }
    /* text fallback when no play*.<image> exists in docs/buttons/ */
    .shuffle-play span.cap {
      aspect-ratio: 1 / 1;
      display: flex; align-items: center; justify-content: center;
      font-size: 2rem; line-height: 1;
    }
    .shuffle-play:hover .cap,
    .shuffle-play:focus-visible .cap {
      transform: scale(1.08);
      border-color: var(--c-green);
    }
    .shuffle-play:focus-visible { outline: none; }
    @media (prefers-reduced-motion: reduce) {
      .shuffle-play .cap { transition: none; }
      .shuffle-play:hover .cap,
      .shuffle-play:focus-visible .cap { transform: none; }
    }

    /* ── About: hand-drawn diagram "gif" (frames flip every 500ms) ──── */
    /* Frames are stacked on top of each other and cross-faded with a stepped
       keyframe, so the loop runs with no JS and no animated-GIF file. The
       wrapper carries the aspect ratio because every frame is absolute. */
    .diagram {
      position: relative;
      width: 100%; max-width: 44rem;
      margin-left: auto; margin-right: auto;
      aspect-ratio: 9 / 5;   /* the frames are 900x500 */
      overflow: hidden;
      border: var(--border-thickness) solid var(--text-color);
      background: #000;
    }
    .diagram .dframe {
      position: absolute; inset: 0; margin: 0;   /* margin: 0 defeats the owl rule */
      width: 100%; height: 100%;
      object-fit: contain;
      opacity: 0;
      animation: diagram-cycle var(--diagram-cycle) steps(1, end) infinite;
    }
    {% set diagram_step = (100.0 / (diagram_frames | length or 1)) | round(3) %}
    @keyframes diagram-cycle {
      0%              { opacity: 1; }
      {{ diagram_step }}%   { opacity: 0; }   /* one slot of the loop per frame */
      100%            { opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      /* one still frame instead of a flicker */
      .diagram .dframe            { animation: none; }
      .diagram .dframe:first-child { opacity: 1; }
    }

    /* The player fills the same box the photos were using. */
    .shuffle iframe {
      position: absolute; inset: 0; margin: 0;
      width: 100%; height: 100%;
      border: 0;
    }

    img { max-width: 100%; }
  </style>
</head>
<body>

  <div class="header">
    <nav class="nav">
      <div class="group">
        <a href="index.html">EN</a>
        <a href="es.html">ES</a>
      </div>
      <div class="group">
        <a href="index.html">cv</a>
        <a href="posts.html">posts</a>
        <a href="about.html" class="active">about</a>
      </div>
    </nav>
    <h1>{{ about.title | default('About') }}</h1>
    {% if about.subtitle %}<div class="subtitle">{{ about.subtitle }}</div>{% endif %}
  </div>

  <!-- ══ SQUARE IMAGE SHUFFLER ═══════════════════════════════════════ -->
  <div class="shuffle" id="shuffle">
    {% if images %}
    {# Never loading="lazy": a hidden frame never intersects the viewport, so it
       would never load at all. Instead the first few frames keep default
       priority and the rest drop to fetchpriority="low", so the opening paint
       is not queued behind every photo in the folder. The script only flips to
       frames that have actually finished downloading. #}
    {% for img in images %}<img class="frame{% if loop.first %} on{% endif %}" src="{{ img }}" alt=""{% if loop.index > 3 %} fetchpriority="low" decoding="async"{% endif %} />{% endfor %}
    {% else %}
    <div class="shuffle-empty">no images yet &mdash; drop files into docs/images-to-rotate/ and rebuild</div>
    {% endif %}
    {% if videos %}
    {# revealed by the script once the shuffle stops; stays hidden without JS #}
    <button type="button" class="shuffle-play" id="shuffle-play" aria-label="Play video">
      {% if play_button %}<img class="cap" src="{{ play_button }}" alt="" />
      {% else %}<span class="cap">&#9654;</span>{% endif %}
    </button>
    {% endif %}
  </div>
  {% if videos %}
  <noscript>
    <div class="shuffle-caption">
      <span class="shuffle-cmd">watch</span>
      <span>{% for v in videos %}<a href="{{ v.url | e }}">{{ v.title | e }}</a>{{ ', ' if not loop.last }}{% endfor %}</span>
    </div>
  </noscript>
  {% endif %}

  <!-- ══ TEXT SECTIONS ═══════════════════════════════════════════════ -->
  {% for sec in about.sections %}
  <section class="section">
    <h2 class="section-title">{{ sec.title }}</h2>
    {% for para in sec.body %}<p>{{ para }}</p>{% endfor %}
    {% if sec.animation == 'diagram' and diagram_frames %}
    {# eager on purpose: a frame that loads late would blink a hole in the loop #}
    <div class="diagram" style="--diagram-cycle: {{ diagram_frames | length * 500 }}ms" aria-label="Animated hand-drawn concept map" role="img">
      {% for f in diagram_frames %}<img class="dframe" src="{{ f }}" alt="" style="animation-delay: {{ loop.index0 * 500 }}ms" />{% endfor %}
    </div>
    {% endif %}
  </section>
  {% endfor %}

  <div class="footer">built automatically from <a href="../data/about.json">about.json</a> &mdash; cv-automat</div>

  <script>
  /* Image shuffle: constant speed, stops after exactly 5s, then offers the
     play button. Progressive enhancement — with JS off the first image stays
     put and the <noscript> link above takes over. */
  (function () {
    var box = document.getElementById('shuffle');
    if (!box) return;

    var imgs   = Array.prototype.slice.call(box.querySelectorAll('img.frame'));
    var status = document.getElementById('shuffle-status');
    var play   = document.getElementById('shuffle-play');
    var VIDEOS = {{ videos | tojson }};

    var setStatus = function (state, text) {
      if (!status) return;
      status.setAttribute('data-state', state);
      status.textContent = text;
    };

    /* Swap the square for a YouTube player. The iframe is only created here,
       on the click — nothing from youtube.com loads before that. */
    var start = function (video) {
      var frame = document.createElement('iframe');
      frame.src = 'https://www.youtube-nocookie.com/embed/' + video.id +
                  '?autoplay=1&rel=0&modestbranding=1' +
                  (video.start ? '&start=' + video.start : '');
      frame.title = video.title;
      /* without `allow`, Chrome ignores autoplay=1 even on a click */
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.setAttribute('allowfullscreen', '');
      frame.referrerPolicy = 'strict-origin-when-cross-origin';

      for (var n = 0; n < imgs.length; n++) imgs[n].className = 'frame';
      play.className = 'shuffle-play';
      box.appendChild(frame);
      setStatus('play', 'playing \u2014 ' + video.title);
    };

    /* One video is drawn at random per page load — same spirit as the images. */
    var offerVideo = function () {
      if (!play || !VIDEOS.length) return;
      var video = VIDEOS[Math.floor(Math.random() * VIDEOS.length)];
      play.setAttribute('aria-label', 'Play: ' + video.title);
      play.title = video.title;
      play.addEventListener('click', function () { start(video); });
      play.className = 'shuffle-play on';
    };

    var done = function () {
      setStatus('done', imgs.length + ' file' + (imgs.length === 1 ? '' : 's') + ' \u2014 stopped');
      offerVideo();
    };

    if (imgs.length < 2) { done(); return; }

    var show = function (i) {
      for (var n = 0; n < imgs.length; n++) imgs[n].className = (n === i) ? 'frame on' : 'frame';
    };
    /* Only frames that finished downloading are eligible: the photos now
       arrive over several seconds, and flipping to a pending one would blank
       the square. `complete` alone is not enough — it is also true for a
       failed load, hence naturalWidth. */
    var pick = function (avoid) {
      var ready = [];
      for (var n = 0; n < imgs.length; n++) {
        if (n !== avoid && imgs[n].complete && imgs[n].naturalWidth) ready.push(n);
      }
      if (!ready.length) return avoid < 0 ? 0 : avoid;   /* nothing else yet — hold */
      return ready[Math.floor(Math.random() * ready.length)];
    };

    var current = pick(-1);
    show(current);

    var reduced = window.matchMedia &&
                  window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) { done(); return; }

    var STEP   = 120;    /* ms between flips — constant, no easing, no ramp */
    var BUDGET = 5000;   /* the shuffle stops after exactly 5s */

    setStatus('run', 'shuffling\u2026');

    var timer = setInterval(function () {
      current = pick(current);
      show(current);
    }, STEP);

    setTimeout(function () { clearInterval(timer); done(); }, BUDGET);
  })();
  </script>

</body>
</html>
